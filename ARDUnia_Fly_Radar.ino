  for (uint8_t i = 0; i < RADAR_RANGE_COUNT; i++) {
    page += F("<option value='"); page += String(RADAR_RANGES_KM[i]); page += F("'");
    if (i == radarRangeIndex) page += F(" selected");
    page += F(">"); page += String(RADAR_RANGES_KM[i]); page += F(" کیلومتر</option>");
