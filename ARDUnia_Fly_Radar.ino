// Apply a valid radar range selected from the web interface and persist it without rebooting.
void handleSetRange() {
  String value = server.arg("rangeKm");
  int requestedKm = value.toInt();
  int foundIndex = -1;
  for (uint8_t i = 0; i < RADAR_RANGE_COUNT; i++) {
    if (requestedKm == RADAR_RANGES_KM[i]) {
      foundIndex = i;
      break;
    }
  }
  if (foundIndex < 0) {
    server.send(400, "text/html; charset=utf-8", makePage("شعاع انتخاب شده معتبر نیست."));
    return;
  }
  if (radarRangeIndex != (uint8_t)foundIndex) {
    radarRangeIndex = (uint8_t)foundIndex;
    saveRadarRange();
  }
  server.send(200, "text/html; charset=utf-8", makePage("شعاع رادار به " + String(RADAR_RANGES_KM[radarRangeIndex]) + " کیلومتر تغییر کرد و ذخیره شد."));
}

