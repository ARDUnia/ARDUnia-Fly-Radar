// Draw a flash-resident RGB565 logo without allocating a full image buffer in RAM.
void drawLogoFromFlash(const uint16_t* bitmap, int x, int y, int width, int height) {
  for (int row = 0; row < height; row++) {
    for (int col = 0; col < width; col++) {
      uint16_t color = pgm_read_word(&bitmap[row * width + col]);
      // 0xFFFF is used as a transparent-pixel marker in the logo bitmaps.
      if (color != 0xFFFF) {
        tft.drawPixel(x + col, y + row, color);
      }
    }
  }
}

// The HTTP server provides setup, Wi-Fi selection, location configuration, and diagnostics.
// In setup mode, the ESP8266 creates this access point so a browser can configure it.
// -------------------- Web server -----------------------------

ESP8266WebServer server(80);

const char* CONFIG_AP_SSID = "ARDUnia-Fly-Radar-Setup";
// Setup AP is intentionally open so first-time setup does not require
// a credential embedded in firmware. Connect only in a trusted location.

String wifiSsid;
String wifiPass;
bool setupApStarted = false;

// EEPROM stores the Wi-Fi credentials and radar center across power cycles.
// CONFIG_MAGIC helps distinguish a valid settings record from erased/random EEPROM data.
// -------------------- Persistent settings --------------------

const int EEPROM_SIZE = 256;
const uint32_t CONFIG_MAGIC = 0x504C5231;

struct RadarSettings {
  uint32_t magic;
  char ssid[33];
  char password[65];
  double latitude;
  double longitude;
};

RadarSettings settings;

// secureClient is reused for HTTPS requests to the aircraft data service.
// The update flags control the first fetch and the regular refresh interval.
// -------------------- Network clients ------------------------

WiFiClientSecure secureClient;

unsigned long lastUpdate = 0;
bool firstUpdate = true;

// Read and validate saved settings before attempting to connect to the saved Wi-Fi network.
// Invalid or uninitialized EEPROM is treated as an unconfigured device.
// ============================================================
// EEPROM SETTINGS
// ============================================================

// Returns true when a valid settings record is present in EEPROM.
bool loadSettings() {
  EEPROM.begin(EEPROM_SIZE);
  EEPROM.get(0, settings);

  settings.ssid[sizeof(settings.ssid) - 1] = '\0';
  settings.password[sizeof(settings.password) - 1] = '\0';

  bool validLocation =
    settings.magic == CONFIG_MAGIC &&
    isfinite(settings.latitude) &&
    isfinite(settings.longitude) &&
    settings.latitude >= -90.0 &&
    settings.latitude <= 90.0 &&
    settings.longitude >= -180.0 &&
    settings.longitude <= 180.0;

  if (!validLocation) {
    memset(&settings, 0, sizeof(settings));
    wifiSsid = "";
    wifiPass = "";
    centerLat = 0.0;
    centerLon = 0.0;
    locationConfigured = false;
    Serial.println(F("No valid settings in EEPROM"));
    return false;
  }

  wifiSsid = String(settings.ssid);
  wifiPass = String(settings.password);
  centerLat = settings.latitude;
  centerLon = settings.longitude;
  locationConfigured = true;

  Serial.println(F("Settings loaded from EEPROM"));
  Serial.print(F("Location configured: "));
  Serial.println(locationConfigured ? F("yes") : F("no"));
  Serial.print(F("Wi-Fi SSID configured: "));
  Serial.println(wifiSsid.length() ? F("yes") : F("no"));
  return true;
}

// Load the zoom level from a dedicated EEPROM address so existing Wi-Fi/location settings remain compatible.
void loadRadarRange() {
  if (EEPROM.read(EEPROM_RANGE_MAGIC_ADDR) == EEPROM_RANGE_MAGIC) {
    uint8_t savedIndex = EEPROM.read(EEPROM_RANGE_INDEX_ADDR);
    if (savedIndex < RADAR_RANGE_COUNT) radarRangeIndex = savedIndex;
  }
  Serial.print(F("Radar range: "));
  Serial.print(RADAR_RANGES_KM[radarRangeIndex]);
  Serial.println(F(" km"));
}

// Persist only when the user changes zoom, avoiding unnecessary EEPROM writes.
void saveRadarRange() {
  EEPROM.write(EEPROM_RANGE_INDEX_ADDR, radarRangeIndex);
  EEPROM.write(EEPROM_RANGE_MAGIC_ADDR, EEPROM_RANGE_MAGIC);
  if (!EEPROM.commit()) Serial.println(F("Warning: could not save radar range to EEPROM"));
}

// Advance through 10, 20, 30, 40, 50, 100, and 500 km, then wrap to 10 km.
void advanceRadarRange() {
  radarRangeIndex = (radarRangeIndex + 1) % RADAR_RANGE_COUNT;
  saveRadarRange();
  Serial.print(F("Radar range changed to "));
  Serial.print(RADAR_RANGES_KM[radarRangeIndex]);
  Serial.println(F(" km"));
  if (WiFi.status() == WL_CONNECTED && locationConfigured) {
    drawRadarBase();
    drawAircraftCount(0);
    firstUpdate = true;
  }
}

// Debounced active-low button input. One press advances exactly one zoom level.
void handleZoomButton() {
  uint8_t reading = digitalRead(ZOOM_BUTTON_PIN);
  if (reading != lastButtonReading) lastButtonChange = millis();
  if (millis() - lastButtonChange >= BUTTON_DEBOUNCE_MS && reading != stableButtonState) {
    stableButtonState = reading;
    if (stableButtonState == LOW) advanceRadarRange();
  }
  lastButtonReading = reading;
}

